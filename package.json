{
  "name": "midi-mpc-converter",
  "version": "0.2.1",
  "description": "Convert MIDI files to MPC pattern format for Akai Force and other Akai products",
  "homepage": "https://codmpm.github.io/medianmpc/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codmpm/medianmpc.git"
  },
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "dev": "webpack serve --mode development",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": [
    "midi",
    "mpc",
    "akai",
    "force",
    "pattern",
    "converter",
    "music"
  ],
  "author": "MIDI MPC Converter Team",
  "license": "MIT",
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "fflate": "^0.8.3",
    "jquery": "^3.6.0",
    "midi-parser-js": "^4.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "@eslint/js": "^10.0.1",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.5.0",
    "prettier": "^3.0.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-react"
    ]
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
